{
  "name": "@iiiokojiadbi/shift",
  "version": "0.34.1",
  "description": "The agent decides by itself when to shift: it keeps a work board and task folders, writes a letter to itself, and continues from where it stopped.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/iiiokojiadbi/shift#readme",
  "bugs": {
    "url": "https://github.com/iiiokojiadbi/shift/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iiiokojiadbi/shift.git",
    "directory": "adapters/npm"
  },
  "keywords": [
    "pi-package",
    "opencode-plugin",
    "pi",
    "opencode",
    "agent",
    "context",
    "memory",
    "handoff"
  ],
  "files": [
    "index.ts",
    "server.ts",
    "store.ts",
    "core",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./server": "./server.ts",
    "./package.json": "./package.json"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  }
}
