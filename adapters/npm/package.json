{
  "name": "@iiiokojiadbi/shift",
  "version": "0.41.1",
  "description": "The agent decides by itself when to shift: it keeps a work board, writes a letter to itself, and continues from where it stopped.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/iiiokojiadbi/shift#readme",
  "bugs": {
    "url": "https://github.com/iiiokojiadbi/shift/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iiiokojiadbi/shift.git",
    "directory": "adapters/npm"
  },
  "keywords": [
    "pi-package",
    "opencode-plugin",
    "pi",
    "opencode",
    "agent",
    "context",
    "memory",
    "handoff"
  ],
  "files": [
    "index.ts",
    "server.ts",
    "store.ts",
    "core",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./server": "./server.ts",
    "./package.json": "./package.json"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@iiiokojiadbi/shift-runtime-linux-x64": "npm:@iiiokojiadbi/shift@0.41.1-linux-x64",
    "@iiiokojiadbi/shift-runtime-linux-arm64": "npm:@iiiokojiadbi/shift@0.41.1-linux-arm64",
    "@iiiokojiadbi/shift-runtime-darwin-x64": "npm:@iiiokojiadbi/shift@0.41.1-darwin-x64",
    "@iiiokojiadbi/shift-runtime-darwin-arm64": "npm:@iiiokojiadbi/shift@0.41.1-darwin-arm64",
    "@iiiokojiadbi/shift-runtime-win32-x64": "npm:@iiiokojiadbi/shift@0.41.1-win32-x64"
  }
}
