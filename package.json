{
  "name": "shift",
  "private": true,
  "type": "module",
  "scripts": {
    "sync-core": "bun scripts/sync-core.ts",
    "check": "bun scripts/sync-core.ts --check && biome check .",
    "fix": "biome check --write .",
    "test": "bun run test:core && bun run test:npm && bun run test:claude-code",
    "test:core": "bun test core/test",
    "test:npm": "bun test adapters/npm/test",
    "test:claude-code": "claude plugin test adapters/claude-code",
    "validate": "claude plugin validate adapters/claude-code",
    "release:npm": "bun scripts/release-npm.ts",
    "typecheck": "bun run types:core && bun run types:claude-code && bun run types:npm",
    "types:core": "tsc -p core && tsc -p core/test",
    "types:claude-code": "tsc -p adapters/claude-code --noEmit",
    "types:npm": "tsc -p adapters/npm && tsc -p adapters/npm/test",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@opencode/plugin": "2.1.4",
    "@types/bun": "^1.4.4",
    "lefthook": "^2.2.2",
    "typescript": "^7.0.2"
  }
}
